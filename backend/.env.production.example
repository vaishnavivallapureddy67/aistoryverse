# Production Environment Variable Template for Render / Server Deployment

PROJECT_NAME=AIStoryVerse

# Neon / Render PostgreSQL Database Connection String
# Note: Neon provides "postgres://..." or "postgresql://...".
# The backend automatically converts it to "postgresql+asyncpg://..." internally.
DATABASE_URL=postgresql+asyncpg://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & CORS
DEBUG=False
ALLOWED_ORIGINS=["https://aistoryverse.vercel.app","https://your-custom-domain.com"]
SECRET_KEY=generate_a_secure_random_64_character_string_here
